# URL do seu projeto no Cloudflare Pages (ex: https://whatsapp-leads-dashboard.pages.dev)
PAGES_URL=https://SEU_PROJETO.pages.dev

# Nome exato do contato ou grupo a monitorar no WhatsApp
TARGET_CONTACT_NAME=Operações Internas - INC Empreendimentos

# (Opcional) Número específico do remetente (apenas dígitos com DDI e DDD, ex: 5511999999999@s.whatsapp.net)
# Se deixado em branco, a filtragem será feita pelo nome do contato / pushName
TARGET_JID=

# Resposta automática a ser enviada no chat
REPLY_TEXT=Integração ok

